# Optional local override for the site URL used in SEO tags (canonical links,
# og:url, sitemap.xml, robots.txt) and other absolute-URL generation.
#
# In production on Vercel, VERCEL_PROJECT_PRODUCTION_URL is detected automatically
# and this variable is ignored. Set it here only to test a specific domain locally,
# or if deploying outside Vercel. Falls back to http://localhost:5173 if unset.
VITE_SITE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Reservation / booking system (see api/ and src/pages/Reservation.tsx)
# ---------------------------------------------------------------------------
# Server-only vars below must NEVER be prefixed with VITE_ — that prefix
# tells Vite to inline the value into the client-side JS bundle, which would
# publicly expose it. Only VITE_TURNSTILE_SITE_KEY is meant to be public.
#
# This file is a TEMPLATE and is tracked by git — never put real values here.
# For real local values, use `.env.local` (gitignored) via `vercel env pull`,
# or set them directly on Vercel (dashboard or `vercel env add`).

# Supabase — server-only, service role key bypasses Row Level Security.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis — used for rate limiting the booking form (5 req/IP/hour).
# If unset, falls back to a weaker in-memory rate limiter (see api/_lib/ratelimit.ts).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile — bot verification on the booking form.
# VITE_TURNSTILE_SITE_KEY is the only public one; TURNSTILE_SECRET_KEY stays server-only.
# If both are unset, verification is skipped (logged loudly) rather than blocking submissions.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Twilio — WhatsApp confirmations and reminders. If unset, sends are skipped
# and logged instead of failing the booking (see api/_lib/whatsapp.ts).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=            # e.g. whatsapp:+14155238886
TWILIO_TEMPLATE_BOOKING_RECEIVED= # approved Content SID for the immediate confirmation
TWILIO_TEMPLATE_REMINDER=         # approved Content SID for the ~24h-out reminder
PHOTOGRAPHER_WHATSAPP_NUMBER=     # E.164, e.g. +96170123456 — gets notified too

# Magic-link booking confirm/decline (see api/_lib/actionToken.ts and
# src/pages/BookingAction.tsx) — tap-through links sent to the photographer
# instead of a password-protected admin page.
#
# TWILIO_TEMPLATE_BOOKING_RECEIVED_PHOTOGRAPHER carries 5 variables
# (client name, session type, date, confirm URL, decline URL). If unset, the
# photographer still gets the plain TWILIO_TEMPLATE_BOOKING_RECEIVED message
# above, just without the tap-through links — same graceful-degrade pattern
# as everything else here. TWILIO_TEMPLATE_BOOKING_CONFIRMED carries 4
# variables (client name, date, notes/location, session type) and is sent to
# the client only after the photographer taps "Confirm" on /booking-action.
BOOKING_ACTION_SECRET=                            # random string, signs the confirm/decline links (HMAC-SHA256)
TWILIO_TEMPLATE_BOOKING_RECEIVED_PHOTOGRAPHER=    # approved Content SID — booking-received-with-action-links
TWILIO_TEMPLATE_BOOKING_CONFIRMED=                # approved Content SID — sent to client after photographer confirms

# Vercel Cron auth — Vercel sends this automatically as a Bearer token when
# calling /api/send-reminders; set it here so the endpoint can verify it.
CRON_SECRET=
