# Optional local override for the site URL used in SEO tags (canonical links,
# og:url, sitemap.xml, robots.txt) and other absolute-URL generation.
#
# In production on Vercel, VERCEL_PROJECT_PRODUCTION_URL is detected automatically
# and this variable is ignored. Set it here only to test a specific domain locally,
# or if deploying outside Vercel. Falls back to http://localhost:5173 if unset.
VITE_SITE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Reservation / booking system (see api/ and src/pages/Reservation.tsx)
# ---------------------------------------------------------------------------
# Server-only vars below must NEVER be prefixed with VITE_ — that prefix
# tells Vite to inline the value into the client-side JS bundle, which would
# publicly expose it. Only VITE_TURNSTILE_SITE_KEY is meant to be public.
#
# This file is a TEMPLATE and is tracked by git — never put real values here.
# For real local values, use `.env.local` (gitignored) via `vercel env pull`,
# or set them directly on Vercel (dashboard or `vercel env add`).

# Supabase — server-only, service role key bypasses Row Level Security.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis — used for rate limiting the booking form (5 req/IP/hour).
# If unset, falls back to a weaker in-memory rate limiter (see api/_lib/ratelimit.ts).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile — bot verification on the booking form.
# VITE_TURNSTILE_SITE_KEY is the only public one; TURNSTILE_SECRET_KEY stays server-only.
# If both are unset, verification is skipped (logged loudly) rather than blocking submissions.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Maps — Autocomplete + draggable-marker picker for session_location
# (see src/components/LocationPicker.tsx). Public by design (domain- and
# API-restricted in Google Cloud Console), same trust level as
# VITE_TURNSTILE_SITE_KEY above. Needs Maps JavaScript API + Places API (New)
# enabled and billing set up on the Google Cloud project.
VITE_GOOGLE_MAPS_API_KEY=

# WhatsApp — click-to-chat only (wa.me), no API/account/billing needed. The
# photographer's number the client is prompted to message right after
# booking (with the magic-link confirm/decline links pre-filled in), and
# whose confirm-success page prompts a click-to-chat back to the client.
PHOTOGRAPHER_WHATSAPP_NUMBER=     # E.164, e.g. +96170123456

# Magic-link booking confirm/decline (see api/_lib/actionToken.ts and
# src/pages/BookingAction.tsx) — tap-through links delivered via the
# click-to-chat message above instead of an automated send, and instead of a
# password-protected admin page.
BOOKING_ACTION_SECRET= # random string, signs the confirm/decline links (HMAC-SHA256)

# ---------------------------------------------------------------------------
# Instagram gallery sync (build-time tooling only — see
# scripts/sync-instagram-photos.ts, run via `npm run sync-instagram`)
# ---------------------------------------------------------------------------
# Server-only. NEVER prefix these with VITE_ — they must never reach the
# client bundle. Used only by the local/cron sync script, never at runtime.
#
# One-time setup (done by hand, no code): convert your Instagram account to a
# professional account, create a Meta app with the Instagram product, generate
# a short-lived token and exchange it for a long-lived one, then paste that
# long-lived token below in `.env.local`. Full steps are in the comment block
# at the top of scripts/sync-instagram-photos.ts.

# Long-lived Instagram Graph API access token (required to run the sync).
INSTAGRAM_ACCESS_TOKEN=
# Optional. Numeric Instagram user id; defaults to "me" (the token's owner).
INSTAGRAM_USER_ID=
# Optional. Gallery category the imported photos are filed under
# (portrait | landscape | street | events); defaults to "street".
INSTAGRAM_CATEGORY=
